        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sussurros de deuses esquecidos se infiltram entre os fiéis. Lentamente, os olhares começam a se voltar para outros altares."
          }
        }
      }
    },
