        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O herege proclama suas dúvidas do topo da montanha, e sua voz ecoa pela floresta."
          }
        }
      }
    },
    "The Heretic Served Heresy as Faith—and You Drank It to the Dregs" : {
