        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em cânticos abafados e círculos ocultos, cerimônias proibidas são conduzidas. Poucos retornam... mas o poder se faz presente."
          }
        }
      }
    },
