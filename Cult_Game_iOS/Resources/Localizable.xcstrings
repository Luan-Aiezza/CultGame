        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo dia se inicia na vila."
          }
        }
      }
    },
    "A new day has begun in the village and you are..." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new day has begun in the village and you are..."
