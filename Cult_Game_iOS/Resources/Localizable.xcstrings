    },
    "The fox was killed" : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A raposa foi morta"
          }
        }
      }
    },
    "The heretic performs a ritual mimicking the cultists, but ends up invoking opposing forces." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heretic performs a ritual mimicking the cultists, but ends up invoking opposing forces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O herege realiza um ritual imitando os cultistas, mas acaba invocando forças opostas."
          }
        }
      }
    },
    "The heretic poses as a divine envoy, luring followers away from the cult." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heretic poses as a divine envoy, luring followers away from the cult."
