        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um grupo de seguidores começa a seguir um caminho alternativo."
          }
        }
      }
    },
    "A new day begins in the village." : {
      "extractionState" : "manual",
      "localizations" : {
