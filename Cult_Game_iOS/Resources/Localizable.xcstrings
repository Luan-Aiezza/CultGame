      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twisted tales and veiled suspicions spread like smoke among the faithful. The leader's figure can no longer be seen with the same trust."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórias distorcidas e suspeitas veladas se espalham como fumaça entre os fiéis. A figura do líder não pode mais ser vista com a mesma confiança."
          }
        }
      }
    },
    "Unbeliever" : {
