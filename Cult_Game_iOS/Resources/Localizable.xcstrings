        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O herege se apresenta como um enviado divino, atraindo seguidores para longe do culto."
          }
        }
      }
    },
    "The heretic proclaims their doubts from the mountaintop, and their voice echoes through the forest." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heretic proclaims their doubts from the mountaintop, and their voice echoes through the forest."
