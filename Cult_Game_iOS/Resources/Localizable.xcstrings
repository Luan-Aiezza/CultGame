        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A primeira luz da manhã toca a vila — e com ela, o peso das escolhas do passado."
          }
        }
      }
    },
    "The flame and unity of the cult burned brighter - the heretic was unmasked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame and unity of the cult burned brighter - the heretic was unmasked"
