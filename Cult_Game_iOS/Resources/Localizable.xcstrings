        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um artefato revela a hipocrisia dos cultistas aos olhos dos fiéis."
          }
        }
      }
    },
    "Ancient verses are recited covertly in the village, seducing restless minds." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
