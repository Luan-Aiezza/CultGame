{
  "sourceLanguage" : "en",
  "strings" : {
    "A believer is corrupted from within. Faith appears intact, but it is poisoned." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A believer is corrupted from within. Faith appears intact, but it is poisoned."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O crente é corrompido por dentro. A fé parece intacta, mas está envenenada."
          }
        }
      }
    },
    "A cursed artifact makes the rituals feel hollow and meaningless." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cursed artifact makes the rituals feel hollow and meaningless."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um artefato amaldiçoado faz com que os rituais pareçam vazios e sem sentido."
          }
        }
      }
    },
    "A forgotten word is whispered on the hill. Whoever hears it is never the same again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forgotten word is whispered on the hill. Whoever hears it is never the same again."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma palavra esquecida é sussurrada na colina. Quem a ouve nunca mais é o mesmo."
          }
        }
      }
    },
    "A group of followers begins to follow an alternative path." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A group of followers begins to follow an alternative path."
